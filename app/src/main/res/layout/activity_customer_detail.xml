<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:stateListAnimator="@null"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:popupTheme="@style/ThemeOverlay.App.PopupMenu"
            app:title="Müşteri Profili"
            app:titleTextAppearance="@style/App.Toolbar.Title"
            app:titleTextColor="@color/white" />

        <!-- Profile lives in the header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvInitials"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_avatar_glass"
                    android:gravity="center"
                    android:text="AY"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Ahmet Yılmaz"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCompanyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="🏢 Şirket Adı"
                        android:textColor="@color/aqua"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="0532 123 45 67"
                        android:textColor="@color/header_text_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvCompanyPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="☎️ Şirket Tel: 0212 123 45 67"
                        android:textColor="@color/header_text_muted"
                        android:textSize="13sp"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/status_orange_bg"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:text="🟠 5 Gün"
                android:textColor="@color/status_orange"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Quick actions -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCall"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/call_blue"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="📞 Ara"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWhatsApp"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/whatsapp_green"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="💬 WhatsApp"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetReservation"
                            style="@style/Widget.App.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/status_reserved_bg"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingHorizontal="4dp"
                            android:text="📅 Randevu Al"
                            android:textColor="@color/status_reserved"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleMute"
                            style="@style/Widget.App.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/status_muted_bg"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingHorizontal="4dp"
                            android:text="🔇 Sustur"
                            android:textColor="@color/status_muted"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Details & maintenance -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADRES"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDistrictAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Bahçelievler / Zafer Mah. Şehitler Cad. No:12 D:4"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tile"
                            android:backgroundTint="@color/surface_soft"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Takılma"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvInstallationDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="15 Mart 2025"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tile"
                            android:backgroundTint="@color/bireysel_light_bg"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sonraki Bakım"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvMaintenanceDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="15 Ekim 2026"
                                android:textColor="@color/bireysel_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Bireysel: single button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefreshMaintenanceBireysel"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/bireysel_primary"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="✅ Bakım Yapıldı (+1 Yıl)"
                        android:textColor="@color/white" />

                    <!-- Lojistik: 3/6/9/12 months -->
                    <LinearLayout
                        android:id="@+id/layoutLojistikRefresh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvRefreshPeriodTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✅ BAKIM YAPILDI — SIRADAKİ PERİYOT"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRefresh3Months"
                                style="@style/Widget.App.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginEnd="3dp"
                                android:layout_weight="1"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:maxLines="1"
                                android:paddingHorizontal="0dp"
                                android:text="+3 Ay"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRefresh6Months"
                                style="@style/Widget.App.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginHorizontal="3dp"
                                android:layout_weight="1"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:maxLines="1"
                                android:paddingHorizontal="0dp"
                                android:text="+6 Ay"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRefresh9Months"
                                style="@style/Widget.App.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginHorizontal="3dp"
                                android:layout_weight="1"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:maxLines="1"
                                android:paddingHorizontal="0dp"
                                android:text="+9 Ay"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRefresh12Months"
                                style="@style/Widget.App.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginStart="3dp"
                                android:layout_weight="1"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:maxLines="1"
                                android:paddingHorizontal="0dp"
                                android:text="+12 Ay"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Notes -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="📝 Servis Geçmişi"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddNote"
                            style="@style/Widget.App.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:backgroundTint="@color/bireysel_light_bg"
                            android:maxLines="1"
                            android:text="+ Not"
                            android:textColor="@color/bireysel_primary"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tvEmptyNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="14dp"
                        android:gravity="center"
                        android:text="Henüz servis notu yok."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Edit / archive -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditCustomer"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/white"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="✏️ Düzenle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnArchiveCustomer"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/white"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="📦 Arşivle"
                    android:textColor="@color/status_red"
                    app:strokeColor="@color/status_red_bg" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
